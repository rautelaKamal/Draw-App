# Copy this file to .env and adjust if needed:
#   cp packages/db/.env.example packages/db/.env
#
# Local dev database. Port 5433 is used because 5432 may already be
# taken by another project's Postgres container.
#
# Start it with:
#   docker run -d --name draw-app-postgres \
#     -e POSTGRES_USER=drawapp \
#     -e POSTGRES_PASSWORD=drawapp_dev \
#     -e POSTGRES_DB=drawapp \
#     -p 5433:5432 \
#     postgres:16-alpine
#
# Then apply the schema:
#   cd packages/db && npx prisma migrate dev
#
# These are throwaway credentials for a localhost-only container.
# Use a real secret for any non-local database.
DATABASE_URL="postgresql://drawapp:drawapp_dev@localhost:5433/drawapp"
